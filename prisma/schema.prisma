// Names App — Simplified Schema (Phase 2 of Names × x402 rebuild)
// Drops: PairedUsername, Trade (NFT mint+trade), Transaction (stub wallets),
//        SocialVerification (unused OAuth multi-platform)
// Keeps simpler tip-based engagement model (StoryValue → Tip).

datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String     @id @default(cuid())
  address       String     @unique
  basename      String?
  tipTotal      Float      @default(0)         // sum of all tips received across all stories
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  stories       Story[]
  tips          Tip[]
}

model Story {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])

  username     String   // canonical username (e.g. "satoshiBuilder")
  platform     String   // base | farcaster | other
  philosophy   String   @db.Text
  address      String   // wallet address — recipient of USDC tips (== user.address)
  tipsCount    Int      @default(0)
  tipsTotal    Float    @default(0)
  lastTipAt    DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tips         Tip[]

  @@unique([username, platform])
  @@index([userId])
  @@index([tipsTotal])      // feed ranking
  @@index([lastTipAt])      // recent activity
}

model Tip {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  from      String   // tipper wallet address
  amount    Float
  txHash    String   @unique

  createdAt DateTime @default(now())

  @@index([storyId])
  @@index([from])
}
